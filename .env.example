# Backend API base URL.
#
# The deployed frontend must point at the already-hosted backend.
# You can use either the origin alone or with the /api suffix:
#   VITE_API_URL=https://YOUR-BACKEND-URL
#   VITE_API_URL=https://YOUR-BACKEND-URL/api
# The client normalizes a trailing /api so both forms work.
#
# In local development you can leave this empty - the Vite dev server
# proxies /api requests to the local backend (see vite.config.js).
VITE_API_URL=
